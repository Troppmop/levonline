# See README.md "Deploying to Railway" for the full production env var
# reference (per-service tables for backend web, backend worker, frontend).

# development | test | production
# NEVER set this to "test" outside of local/CI E2E runs — it mounts a
# /testing/reset endpoint that drops all tables.
ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://levlachayal:levlachayal@localhost:5432/levlachayal
REDIS_URL=redis://localhost:6379/0

# Generate a real secret for production, e.g. `openssl rand -hex 32`.
# Rotating this invalidates all existing access/refresh tokens.
JWT_SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Comma-separated if multiple origins.
CORS_ORIGINS=http://localhost:5173

# In production, mount a persistent volume at this path (e.g. a Railway
# volume) or uploaded damage-report photos are lost on every redeploy.
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
